---
import { Image } from 'astro:assets';
import type { PortfolioCase } from '@data/cases';

type Props = {
  caseItem: PortfolioCase;
};

const { caseItem } = Astro.props;
const [frontImage, middleImage, backImage] = caseItem.previewImages;
const captionMatch = caseItem.caption.match(/^(.*?)(м)2$/);
---

<button
  class="case-folder"
  type="button"
  data-case-card
  data-case-slug={caseItem.slug}
  data-case-category={caseItem.category}
  aria-label={`Открыть кейс ${caseItem.title}`}
>
  <span class="case-folder-stack" aria-hidden="true">
    {backImage && (
      <span class="case-folder-layer case-folder-layer-back">
        <Image src={backImage} alt="" width={460} format="webp" quality={72} loading="lazy" decoding="async" />
      </span>
    )}
    {middleImage && (
      <span class="case-folder-layer case-folder-layer-middle">
        <Image src={middleImage} alt="" width={520} format="webp" quality={72} loading="lazy" decoding="async" />
      </span>
    )}
    <span class="case-folder-layer case-folder-layer-front">
      <Image src={frontImage} alt="" width={620} format="webp" quality={72} loading="lazy" decoding="async" />
    </span>
  </span>
  <span class="case-folder-caption">
    {captionMatch ? (
      <>
        {captionMatch[1]}{captionMatch[2]}<sup>2</sup>
      </>
    ) : (
      caseItem.caption
    )}
  </span>
</button>

<style>
  .case-folder {
    appearance: none;
    position: relative;
    width: 100%;
    border: 0;
    border-radius: var(--radius);
    background: transparent;
    color: var(--text);
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: 0;
    text-align: left;
  }

  .case-folder-stack {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    padding: 16px 14px 10px;
  }

  .case-folder-layer {
    position: absolute;
    inset: 16px 14px 10px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.16);
    border-radius: var(--radius);
    background: var(--card);
    box-shadow: 0 22px 55px rgba(0,0,0,0.32);
    transform-origin: center bottom;
    transition: transform 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease;
  }

  .case-folder-layer :global(img) {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .case-folder-layer-back {
    transform: translate(14px, -12px) rotate(4deg);
    opacity: 0.74;
  }

  .case-folder-layer-middle {
    transform: translate(7px, -6px) rotate(2deg);
    opacity: 0.86;
  }

  .case-folder-layer-front {
    transform: translate(0, 0) rotate(0deg);
  }

  .case-folder-caption {
    position: absolute;
    left: 34px;
    right: 34px;
    bottom: 28px;
    z-index: 10;
    display: inline-block;
    width: fit-content;
    max-width: calc(100% - 68px);
    border: 1px solid rgba(255,255,255,0.22);
    border-radius: var(--radius);
    background: rgba(10,10,15,0.88);
    backdrop-filter: blur(10px);
    box-shadow: 0 16px 36px rgba(0,0,0,0.35);
    padding: 8px 10px;
    font-family: var(--font-body);
    font-size: clamp(13px, 1vw, 15px);
    font-weight: 800;
    line-height: 1.2;
    color: var(--text);
  }

  .case-folder-caption sup {
    font-size: 0.68em;
    line-height: 0;
    vertical-align: super;
  }

  .case-folder:hover .case-folder-layer,
  .case-folder:focus-visible .case-folder-layer {
    border-color: rgba(255,77,28,0.52);
    box-shadow: 0 28px 70px rgba(0,0,0,0.42);
  }

  .case-folder:hover .case-folder-layer-back,
  .case-folder:focus-visible .case-folder-layer-back {
    transform: translate(24px, -20px) rotate(7deg);
  }

  .case-folder:hover .case-folder-layer-middle,
  .case-folder:focus-visible .case-folder-layer-middle {
    transform: translate(12px, -10px) rotate(3.5deg);
  }

  .case-folder:hover .case-folder-layer-front,
  .case-folder:focus-visible .case-folder-layer-front {
    transform: translate(-3px, 3px) rotate(-1deg);
  }

  .case-folder:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 10px;
  }

  @media (max-width: 640px) {
    .case-folder {
      gap: 0;
    }

    .case-folder-stack {
      aspect-ratio: 16 / 13;
    }

    .case-folder-caption {
      left: 28px;
      right: 28px;
      bottom: 24px;
      max-width: calc(100% - 56px);
      padding: 7px 9px;
    }
  }
</style>
