---
import logo from '../../assets/images/playroom-logo.png';

export const page = 1;
---

<nav>
  <a href="#" class="nav-logo" aria-label="PlayRoom Studio">
    <img src={logo.src} alt="" class="nav-logo-mark" />
    <span>PlayRoom Studio</span>
  </a>
  <ul class="nav-links">
    <li><a href="#about">О&nbsp;нас</a></li>
    <li><a href="#projects">Проекты</a></li>
    <li><a href="#reviews">Отзывы</a></li>
    <li><a href="#contact">Контакты</a></li>
  </ul>
</nav>

<style>
  nav {
    --nav-font-weight: 700;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 7px 80px 7px 16px;
    background: rgba(3,3,6,0.72);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .nav-logo {
    display: inline-flex;
    align-items: center;
    gap: 18px;
    font-family: var(--font-body);
    font-weight: var(--nav-font-weight);
    font-size: 15px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text);
    text-decoration: none;
  }

  .nav-logo-mark {
    width: 70px;
    height: 70px;
    border-radius: 50%;
    display: block;
  }

  .nav-links {
    display: flex;
    gap: 46px;
    list-style: none;
  }

  .nav-links a {
    font-size: 13px;
    font-weight: var(--nav-font-weight);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.92);
    text-decoration: none;
    transition: color 0.3s;
  }

  .nav-links a:hover {
    color: var(--text);
  }

  @media (max-width: 900px) {
    :global(:root) {
      --header-height: 73px;
    }

    nav {
      padding: 10px 24px;
    }

    .nav-logo {
      gap: 16px;
      font-size: 13px;
    }

    .nav-logo-mark {
      width: 52px;
      height: 52px;
    }

    .nav-links {
      display: none;
    }
  }
</style>
