---
import heroImage from '../../assets/images/hero-interior.png';

export const page = 2;
---

<section class="hero" id="home">
  <div class="hero-media">
    <img src={heroImage.src} alt="Интерьер компьютерного клуба PlayRoom Studio" />
  </div>
  <div class="hero-content">
    <p class="hero-eyebrow">Boutique-студия полного цикла</p>
    <h1 class="hero-title">PlayRoom <em>Studio</em></h1>
    <p class="hero-sub"><strong>7 дней</strong> от замера до финального чертежа</p>
    <a href="#contact" class="hero-cta">
      Получить смету бесплатно
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
        <path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="white" stroke-width="1.5" stroke-linecap="round" />
      </svg>
    </a>
    <div class="hero-stats">
      <div class="hero-stat">
        <div class="hero-stat-num">30<span>+</span></div>
        <div class="hero-stat-label">Реализованных проектов</div>
      </div>
      <div class="hero-stat">
        <div class="hero-stat-num">5</div>
        <div class="hero-stat-label">Лет на рынке</div>
      </div>
      <div class="hero-stat">
        <div class="hero-stat-num">100<span>%</span></div>
        <div class="hero-stat-label">Проекты сданы в&nbsp;срок</div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    overflow: hidden;
    padding: 128px 5.4vw 72px;
    background: #030306;
  }

  .hero-media {
    position: absolute;
    top: var(--header-height);
    right: 0;
    bottom: 0;
    width: 58%;
  }

  .hero-media::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(90deg, #030306 0%, rgba(3,3,6,0.82) 18%, rgba(3,3,6,0.28) 42%, rgba(3,3,6,0) 62%);
  }

  .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    width: min(50vw, 820px);
    padding-top: 24px;
  }

  .hero-eyebrow {
    font-size: clamp(13px, 1.15vw, 18px);
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 28px;
    animation: fadeUp 0.9s 0.1s ease both;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(62px, 6.4vw, 106px);
    font-weight: 700;
    line-height: 1.0;
    letter-spacing: -0.02em;
    margin-bottom: 30px;
    white-space: nowrap;
    animation: fadeUp 0.9s 0.15s ease both;
  }

  .hero-title em {
    color: var(--accent);
    font-weight: 400;
    font-style: italic;
  }

  .hero-sub {
    font-size: clamp(22px, 1.8vw, 30px);
    color: rgba(255,255,255,0.68);
    margin-bottom: 50px;
    animation: fadeUp 0.9s 0.3s ease both;
  }

  .hero-sub strong {
    color: var(--text);
    font-weight: 600;
  }

  .hero :global(.hero-cta) {
    min-width: 416px;
    justify-content: center;
  }

  .hero-stats {
    display: flex;
    align-items: flex-start;
    gap: clamp(56px, 7vw, 118px);
    margin-top: clamp(80px, 9vh, 118px);
    animation: fadeUp 0.9s 0.5s ease both;
  }

  .hero-stat-num {
    font-family: var(--font-display);
    font-size: clamp(44px, 4vw, 62px);
    font-weight: 700;
    color: var(--text);
    line-height: 1;
  }

  .hero-stat-num span {
    color: var(--accent);
  }

  .hero-stat-label {
    max-width: 190px;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.82);
    line-height: 1.5;
    margin-top: 12px;
  }

  @media (max-width: 900px) {
    .hero {
      padding: 112px 24px 64px;
      min-height: 100svh;
    }

    .hero-media {
      left: 0;
      width: 100%;
      opacity: 0.58;
    }

    .hero-media::before {
      background: linear-gradient(90deg, rgba(3,3,6,0.95) 0%, rgba(3,3,6,0.72) 56%, rgba(3,3,6,0.45) 100%);
    }

    .hero-content {
      width: 100%;
      padding-top: 0;
    }

    .hero-title {
      white-space: normal;
    }

    .hero :global(.hero-cta) {
      min-width: 0;
      width: 100%;
      max-width: 420px;
    }

    .hero-stats {
      gap: 36px;
      flex-wrap: wrap;
      margin-top: 64px;
    }
  }
</style>
