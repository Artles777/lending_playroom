---
import logo from '../../assets/images/playroom-logo.png';

export const page = 2;
---

<section class="hero" id="home">
  <div class="hero-grid"></div>
  <div class="hero-glow"></div>
  <img src={logo.src} alt="PlayRoom Studio" class="hero-logo" />
  <p class="hero-eyebrow">Boutique-студия полного цикла</p>
  <h1 class="hero-title">PlayRoom</h1>
  <p class="hero-title-alt">Studio</p>
  <p class="hero-sub">Дизайн коммерческих пространств,<br />который работает на вас — от первого<br />замера до финального чертежа</p>
  <a href="#contact" class="hero-cta">
    Получить смету бесплатно
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
      <path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="white" stroke-width="1.5" stroke-linecap="round" />
    </svg>
  </a>
  <div class="hero-stats">
    <div class="hero-stat">
      <div class="hero-stat-num">30<span style="color:var(--accent)">+</span></div>
      <div class="hero-stat-label">Реализованных проектов</div>
    </div>
    <div class="hero-stat">
      <div class="hero-stat-num">5</div>
      <div class="hero-stat-label">Лет на рынке</div>
    </div>
    <div class="hero-stat">
      <div class="hero-stat-num">100<span style="color:var(--accent)">%</span></div>
      <div class="hero-stat-label">Проектов сданы в срок</div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    padding: 120px 48px 80px;
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,77,28,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,77,28,0.04) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 20%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 20%, transparent 100%);
  }

  .hero-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(255,77,28,0.08) 0%, transparent 70%);
    pointer-events: none;
  }

  .hero-logo {
    width: 140px;
    height: 140px;
    border-radius: 50%;
    margin-bottom: 48px;
    position: relative;
    z-index: 1;
    animation: fadeUp 0.9s ease both;
  }

  .hero-eyebrow {
    font-size: 11px;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 20px;
    position: relative;
    z-index: 1;
    animation: fadeUp 0.9s 0.1s ease both;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(52px, 8vw, 96px);
    font-weight: 700;
    line-height: 1.0;
    letter-spacing: -0.02em;
    margin-bottom: 8px;
    position: relative;
    z-index: 1;
    animation: fadeUp 0.9s 0.15s ease both;
  }

  .hero-title-alt {
    font-family: var(--font-display);
    font-size: clamp(52px, 8vw, 96px);
    font-weight: 400;
    font-style: italic;
    line-height: 1.0;
    color: var(--accent);
    margin-bottom: 36px;
    position: relative;
    z-index: 1;
    animation: fadeUp 0.9s 0.2s ease both;
  }

  .hero-sub {
    font-size: 16px;
    color: var(--muted);
    max-width: 520px;
    margin-bottom: 52px;
    position: relative;
    z-index: 1;
    animation: fadeUp 0.9s 0.3s ease both;
  }

  .hero-stats {
    display: flex;
    gap: 64px;
    margin-top: 80px;
    position: relative;
    z-index: 1;
    animation: fadeUp 0.9s 0.5s ease both;
  }

  .hero-stat {
    text-align: center;
  }

  .hero-stat-num {
    font-family: var(--font-display);
    font-size: 42px;
    font-weight: 700;
    color: var(--text);
    line-height: 1;
  }

  .hero-stat-label {
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 6px;
  }

  @media (max-width: 900px) {
    .hero-stats {
      gap: 36px;
      flex-wrap: wrap;
      justify-content: center;
    }
  }
</style>
