<div class="case-carousel" data-case-carousel>
  <div class="case-carousel-viewport" data-case-carousel-viewport>
    <div class="case-carousel-track" data-case-carousel-track></div>
  </div>

  <div class="case-carousel-controls">
    <button class="case-carousel-control" type="button" data-case-carousel-prev aria-label="Предыдущее фото">‹</button>
    <span class="case-carousel-counter" data-case-carousel-counter>1 / 1</span>
    <button class="case-carousel-control" type="button" data-case-carousel-next aria-label="Следующее фото">›</button>
  </div>

  <div class="case-carousel-pagination" data-case-carousel-pagination aria-label="Пагинация галереи"></div>
</div>

<style>
  .case-carousel {
